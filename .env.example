# -------------------------------------------------------------
# BOX INN Member Companion - Environment Configuration Template
# Copy this file to .env for local development.
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS TO GIT.
# -------------------------------------------------------------

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gym Local Timezone
GYM_TIMEZONE=Asia/Kolkata

# PostgreSQL Connection Strings
# Local (Unix Socket): postgresql://postgres@localhost/boxinn_companion?host=/tmp/boxinn_pg&port=5432
# Local (TCP / Docker): postgresql://boxinn_user:boxinn_dev_password@localhost:5432/boxinn_companion
# Production (Pooled): postgresql://<user>:<password>@<pooler-host>:6543/boxinn_companion?pgbouncer=true
DATABASE_URL="postgresql://postgres@localhost/boxinn_companion?host=/tmp/boxinn_pg&port=5432"

# Direct URL for Prisma migrations in production (bypassing connection pooler)
DIRECT_URL="postgresql://postgres@localhost/boxinn_companion?host=/tmp/boxinn_pg&port=5432"

# Session Encryption Secret (Generate with: openssl rand -hex 32)
# Must be at least 32 characters long.
SESSION_SECRET="change-this-to-a-secure-32-byte-hex-string-for-local-dev"

# Cron Reconcile Secret for /api/cron/reconcile
# Authorization header: Bearer <CRON_SECRET>
CRON_SECRET="change-this-to-a-secure-cron-secret-for-reconcile"

# Transactional Email Dispatcher Configuration
# In development, leave blank or set to 'memory' to use the built-in in-memory dispatcher.
# In production, configure your provider (e.g., Resend, Postmark, AWS SES).
EMAIL_PROVIDER="memory"
# RESEND_API_KEY=""
# EMAIL_FROM="BOX INN <noreply@boxinn.in>"
